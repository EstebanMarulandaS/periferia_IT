{
  "name": "social-network-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "services/shared/*"
  ],
  "scripts": {
    "dev:auth": "npm --workspace services/auth-service run dev",
    "dev:posts": "npm --workspace services/posts-service run dev",
    "dev": "npm -w services/auth-service run dev & npm -w services/posts-service run dev",
    "build": "npm -ws run build",
    "lint": "npm -ws run lint",
    "test": "npm -ws run test"
  },
  "devDependencies": {
    "@types/node": "^25.2.0"
  }
}
