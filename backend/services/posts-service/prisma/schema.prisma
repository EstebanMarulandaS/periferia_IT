datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["posts"]
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Post")
  @@schema("posts")
  @@index([authorId])
}
